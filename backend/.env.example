# Mẫu biến môi trường backend. Chủ file: Hồng Anh (config/).
# Copy thành backend/.env rồi tự điền. KHÔNG commit file .env thật.

# --- Máy chủ ---
PORT=3000
NODE_ENV=development
# Địa chỉ FE được gọi API, cách nhau bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173
# Địa chỉ FE dùng để ghép link đặt lại mật khẩu trong email
APP_URL=http://localhost:5173

# --- CSDL (khớp docker-compose.yml) ---
DATABASE_URL=postgresql://gym:gym@localhost:5432/gym?schema=public

# --- JWT (Triển dùng) ---
# Chuỗi ngẫu nhiên dài, mỗi máy tự đặt. Bắt buộc khi NODE_ENV=production.
JWT_SECRET=

# --- Mail (dev dùng MailHog, xem mail ở http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Phong Gym <no-reply@gym.local>"

# --- VNPay sandbox (tuần 3, Triển điền) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=

# --- Seed (npm run seed) ---
# Mật khẩu chung cho mọi tài khoản seed (admin, staff, PT, hội viên). Chỉ dùng ở máy dev và staging.
SEED_DEFAULT_PASSWORD=
