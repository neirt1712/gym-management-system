          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"receivedAmount\": 1 }" },
            "url": "{{baseUrl}}/payments/{{paymentId}}/confirm-cash"
          }
        },
        {
          "name": "POST /payments/{id}/confirm-cash — Staff nhận đủ tiền",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 payment SUCCESS', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('SUCCESS'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"receivedAmount\": {{packagePrice}} }" },
            "url": "{{baseUrl}}/payments/{{paymentId}}/confirm-cash"
          }
        },
        {
          "name": "POST /payments/{id}/confirm-cash — bấm lại → vẫn 200, không sinh gói thứ hai",
