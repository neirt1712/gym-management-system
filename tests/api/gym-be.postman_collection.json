            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{newToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"currentPassword\": \"matkhau123\", \"newPassword\": \"matkhaumoi456\" }" },
            "url": "{{baseUrl}}/auth/change-password"
          }
