            "pm.test('200, dạng {data, meta}', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().meta.total).to.be.a('number'); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }], "url": "{{baseUrl}}/payments?from=2020-01-01&to=2030-12-31" }
        }
