          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, dạng {data, meta}', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.keys('data', 'meta'); });",
            "const gym = pm.response.json().data.find((p) => p.type === 'GYM' && p.status === 'ACTIVE');",
            "pm.test('có gói GYM đang bán', () => pm.expect(gym).to.be.an('object'));",
