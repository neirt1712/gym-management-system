          "name": "POST /auth/change-password — đúng → phiên mới, token cũ bị thu hồi",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, trả phiên mới', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().accessToken).to.be.a('string'); });",
            "const oldToken = pm.collectionVariables.get('newToken');",
            "pm.collectionVariables.set('newToken', pm.response.json().accessToken);",
            "pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/me', header: { Authorization: 'Bearer ' + oldToken } }, (err, res) => {",
