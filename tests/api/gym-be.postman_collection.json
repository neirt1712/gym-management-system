            "pm.test('200 SUCCESS như lần trước', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('SUCCESS'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{staffToken}}" }],
