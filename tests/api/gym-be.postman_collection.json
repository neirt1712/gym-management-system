          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }], "url": "{{baseUrl}}/packages?type=GYM" }
        },
        {
          "name": "POST /orders/quote — báo giá, BE tính endsOn",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, total = giá gói, có startsOn và endsOn', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b.total).to.eql(Number(pm.collectionVariables.get('packagePrice'))); pm.expect(b.endsOn).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"packageId\": \"{{packageId}}\" }" },
            "url": "{{baseUrl}}/orders/quote"
