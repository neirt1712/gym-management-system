        {
          "name": "POST /orders — tạo đơn (chạy lại thì 409 PENDING_ORDER_EXISTS, vẫn lấy orderId)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const b = pm.response.json();",
            "pm.test('201 đơn PENDING hoặc 409 PENDING_ORDER_EXISTS kèm orderId', () => {",
            "  pm.expect([201, 409]).to.include(pm.response.code);",
            "  if (pm.response.code === 201) pm.expect(b.status).to.eql('PENDING');",
            "  else pm.expect(b.error.code).to.eql('PENDING_ORDER_EXISTS');",
            "});",
            "pm.collectionVariables.set('orderId', pm.response.code === 201 ? b.id : b.error.details.orderId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{memberToken}}" }],
