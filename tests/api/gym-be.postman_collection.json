    {
      "name": "5. VNPay với IPN tự ký (UC12)",
      "description": "VNPay không gọi được về máy local, nên IPN được giả lập: pre-request ký tham số bằng HMAC SHA512 với `vnpHashSecret` (phải trùng VNPAY_HASH_SECRET của backend). Dùng tài khoản mới đăng ký ở mục 1 để không vướng đơn chờ của hội viên seed.",
      "item": [
        {
          "name": "POST /orders — đơn mới cho khách vừa đăng ký",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('vnpOrderId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{newToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"packageId\": \"{{packageId}}\" }" },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "POST /orders/{id}/payments — VNPAY trả checkoutUrl",
          "event": [{ "listen": "test", "script": { "exec": [
            "const b = pm.response.json();",
            "pm.test('201, có checkoutUrl và merchantRef', () => { pm.response.to.have.status(201); pm.expect(b.checkoutUrl).to.include('vnp_SecureHash='); pm.expect(b.merchantRef).to.be.a('string'); });",
            "pm.collectionVariables.set('merchantRef', b.merchantRef);",
            "pm.collectionVariables.set('vnpAmount', String(b.amount * 100));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{newToken}}" }],
            "body": { "mode": "raw", "raw": "{ \"method\": \"VNPAY\" }" },
            "url": "{{baseUrl}}/orders/{{vnpOrderId}}/payments"
          }
        },
        {
          "name": "GET /payments/vnpay/ipn — sai chữ ký → RspCode 97",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, RspCode 97', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().RspCode).to.eql('97'); });"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/payments/vnpay/ipn?vnp_TxnRef={{merchantRef}}&vnp_Amount={{vnpAmount}}&vnp_ResponseCode=00&vnp_TransactionStatus=00&vnp_TransactionNo=PM{{merchantRef}}&vnp_SecureHash=sai" }
        },
        {
          "name": "GET /payments/vnpay/ipn — thành công → RspCode 00, gói kích hoạt",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const params = { vnp_Amount: pm.collectionVariables.get('vnpAmount'), vnp_ResponseCode: '00', vnp_TransactionNo: 'PM' + pm.collectionVariables.get('merchantRef'), vnp_TransactionStatus: '00', vnp_TxnRef: pm.collectionVariables.get('merchantRef') };",
              "const query = Object.keys(params).sort().map((k) => k + '=' + encodeURIComponent(params[k]).replace(/%20/g, '+')).join('&');",
              "const hash = CryptoJS.HmacSHA512(query, pm.collectionVariables.get('vnpHashSecret')).toString(CryptoJS.enc.Hex);",
              "pm.variables.set('ipnQuery', query + '&vnp_SecureHash=' + hash);"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('200, RspCode 00', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().RspCode).to.eql('00'); });"
            ] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/payments/vnpay/ipn?{{ipnQuery}}" }
        },
        {
          "name": "GET /payments/vnpay/ipn — gọi lặp → RspCode 02, không tạo gói lần hai",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const params = { vnp_Amount: pm.collectionVariables.get('vnpAmount'), vnp_ResponseCode: '00', vnp_TransactionNo: 'PM' + pm.collectionVariables.get('merchantRef'), vnp_TransactionStatus: '00', vnp_TxnRef: pm.collectionVariables.get('merchantRef') };",
              "const query = Object.keys(params).sort().map((k) => k + '=' + encodeURIComponent(params[k]).replace(/%20/g, '+')).join('&');",
              "const hash = CryptoJS.HmacSHA512(query, pm.collectionVariables.get('vnpHashSecret')).toString(CryptoJS.enc.Hex);",
              "pm.variables.set('ipnQuery', query + '&vnp_SecureHash=' + hash);"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('200, RspCode 02', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().RspCode).to.eql('02'); });"
            ] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/payments/vnpay/ipn?{{ipnQuery}}" }
        },
        {
          "name": "GET /orders/{id} — FE đọc lại: đơn PAID",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 PAID, có biên lai', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('PAID'); pm.expect(pm.response.json().receiptNo).to.be.a('string'); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{newToken}}" }], "url": "{{baseUrl}}/orders/{{vnpOrderId}}" }
        }
      ]
    },
    {
      "name": "6. Đăng xuất (UC03)",
      "item": [
        {
          "name": "POST /auth/logout — xóa cookie, 204",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('204', () => pm.response.to.have.status(204));"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }], "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    }
  ]
}
