{
  "info": {
    "name": "Gym BE — Xác thực, hồ sơ, đơn hàng, thanh toán, gói hội viên",
    "description": "Request mẫu cho Huy Trường test API thật (Triển, 08/11/2026). Hợp đồng: docs/api/openapi.yaml 0.2.2.\nChạy theo thứ tự từ trên xuống (Run collection). Cần backend chạy local và đã `npm run seed`.\nĐiền biến `seedPassword` (giá trị SEED_DEFAULT_PASSWORD trong backend/.env) và `vnpHashSecret` (VNPAY_HASH_SECRET) ở tab Variables của collection; không commit giá trị thật.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "seedPassword", "value": "" },
    { "key": "vnpHashSecret", "value": "" },
    { "key": "memberPhone", "value": "0910000001" },
    { "key": "staffPhone", "value": "0900000011" },
    { "key": "memberToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "packageId", "value": "" },
    { "key": "packagePrice", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "vnpOrderId", "value": "" },
    { "key": "merchantRef", "value": "" },
    { "key": "vnpAmount", "value": "" },
    { "key": "newPhone", "value": "" },
    { "key": "newToken", "value": "" }
  ],
  "item": [
    {
      "name": "0. Vận hành",
      "item": [
        {
          "name": "GET /health — server và DB sống",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, status ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });",
            "pm.test('có header x-request-id', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "1. Xác thực (UC01, UC02, UC03, UC06)",
      "item": [
        {
          "name": "POST /auth/login — hội viên (lưu memberToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, có accessToken 15 phút', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().expiresIn).to.eql(900); });",
            "pm.test('đặt cookie refresh_token HttpOnly', () => pm.expect(pm.response.headers.get('set-cookie') || '').to.include('HttpOnly'));",
            "pm.test('không trả passwordHash', () => pm.expect(pm.response.json().user).to.not.have.property('passwordHash'));",
            "pm.collectionVariables.set('memberToken', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"phone\": \"{{memberPhone}}\", \"password\": \"{{seedPassword}}\" }" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login — Staff (lưu staffToken)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, vai trò STAFF', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.role).to.eql('STAFF'); });",
            "pm.collectionVariables.set('staffToken', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
