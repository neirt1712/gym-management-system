# Chép thành .env.local rồi sửa. Không commit .env.local.
# Địa chỉ API (base /api/v1). Dùng khi VITE_AUTH_MODE=http.
VITE_API_URL=http://localhost:3000/api/v1
# fake: đăng nhập bằng tài khoản mẫu, không cần backend (trước khi có openapi v0.1)
# http: gọi API thật hoặc mock Prism
VITE_AUTH_MODE=fake
